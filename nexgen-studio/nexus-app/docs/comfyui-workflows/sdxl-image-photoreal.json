{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    }
  },
  "2": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "batch_size": 1,
      "height": "{{height}}",
      "width": "{{width}}"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "{{prompt}}"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "{{negative_prompt}}"
    }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "cfg": "{{cfg}}",
      "denoise": "{{denoise}}",
      "latent_image": ["2", 0],
      "model": ["1", 0],
      "negative": ["4", 0],
      "positive": ["3", 0],
      "sampler_name": "{{sampler_name}}",
      "scheduler": "{{scheduler}}",
      "seed": "{{seed}}",
      "steps": "{{steps}}"
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["5", 0],
      "vae": ["1", 2]
    }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "sdxl_photoreal",
      "images": ["6", 0]
    }
  }
}
