# ==========================================
# Core Application
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave empty to use same-origin /api/* from the Next app (recommended).
NEXT_PUBLIC_API_URL=
# Server-side fetch base (optional; falls back to NEXT_PUBLIC_APP_URL)
INTERNAL_API_URL=http://localhost:3000
NODE_ENV=development

# ==========================================
# Database (Supabase)
# ==========================================
# Direct Postgres (worker / migrations tooling); Supabase local default port 54322
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Public URL for browser + REST (same value as dashboard "Project URL")
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Alias some server code may read (optional)
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==========================================
# Authentication
# ==========================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-minimum

# ==========================================
# AI / ComfyUI
# ==========================================
COMFYUI_URL=http://localhost:8188
COMFYUI_WS_URL=ws://localhost:8188/ws
COMFYUI_API_KEY=

# ==========================================
# Redis (Job Queue + rate limits + WS fan-out)
# ==========================================
# 6380 = this repo's docker-compose published port (avoids clashing with another Redis on 6379).
# Use redis://127.0.0.1:6379 if you run a standalone Redis instead.
REDIS_URL=redis://127.0.0.1:6380
REDIS_PASSWORD=

# ==========================================
# Storage (S3 / Cloudflare R2 / MinIO)
# ==========================================
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET_NAME=nexus-assets
# MinIO / R2 custom endpoint (no trailing slash)
AWS_ENDPOINT_URL=http://127.0.0.1:9000
# Public base URL for objects (MinIO path-style or CDN)
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/nexus-assets

# ==========================================
# Stripe (Billing)
# ==========================================
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ==========================================
# WebSocket (optional standalone server)
# ==========================================
WS_PORT=3002
NEXT_PUBLIC_WS_URL=ws://localhost:3002

# ==========================================
# Monitoring
# ==========================================
SENTRY_DSN=
LOG_LEVEL=info

# ==========================================
# AI Safety (Optional)
# ==========================================
NSFW_DETECTION_API_KEY=
CLARIFAI_API_KEY=
