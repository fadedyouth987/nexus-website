# Jobryn environment contract
# Copy to .env.local for local Next.js development or .dev.vars for Wrangler local development.
# Never commit real secret values. Public NEXT_PUBLIC_* values are intentionally browser-visible.

# -----------------------------------------------------------------------------
# Public application configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://jobryn.org
NEXT_PUBLIC_SITE_URL=https://jobryn.org
NEXTAUTH_URL=https://jobryn.org

# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://pmqtkcenovlwshurglkp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_H7ggm7ASPc-HgDQdMIBWeQ__9GCzVus
SUPABASE_URL=https://pmqtkcenovlwshurglkp.supabase.co

# -----------------------------------------------------------------------------
# Required production secrets
# Set these as Cloudflare Worker secrets, not Wrangler vars and not in git.
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=<set-as-cloudflare-secret-minimum-32-characters>
SUPABASE_SERVICE_ROLE_KEY=<set-as-cloudflare-secret>

# Recommended separate key for encrypting stored social access/refresh tokens.
# If omitted, the current implementation falls back to NEXTAUTH_SECRET.
SOCIAL_TOKEN_ENCRYPTION_KEY=<set-as-cloudflare-secret>

# -----------------------------------------------------------------------------
# Stripe (required when billing is enabled)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=<set-as-cloudflare-secret>
STRIPE_WEBHOOK_SECRET=<set-as-cloudflare-secret>
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=<stripe-publishable-key>
STRIPE_PRICE_TIER1_MONTHLY=<stripe-price-id>
STRIPE_PRICE_TIER1_YEARLY=<stripe-price-id>
STRIPE_PRICE_TIER2_MONTHLY=<stripe-price-id>
STRIPE_PRICE_TIER2_YEARLY=<stripe-price-id>
STRIPE_PRICE_TIER3_MONTHLY=<stripe-price-id>
STRIPE_PRICE_TIER3_YEARLY=<stripe-price-id>
STRIPE_PRICE_ENTERPRISE_MONTHLY=<stripe-price-id>
STRIPE_PRICE_ENTERPRISE_YEARLY=<stripe-price-id>

# -----------------------------------------------------------------------------
# AI / LLM (configure at least one provider when Assistant features are enabled)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=<set-as-cloudflare-secret>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

OPENAI_API_KEY=<set-as-cloudflare-secret>
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
OPENAI_ROUTER_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Meta / Instagram social publishing (optional until integration is enabled)
# -----------------------------------------------------------------------------
META_APP_ID=<meta-app-id>
META_APP_SECRET=<set-as-cloudflare-secret>
META_WEBHOOK_VERIFY_TOKEN=<set-as-cloudflare-secret>
INSTAGRAM_APP_ID=<instagram-app-id-or-use-meta-app-id>
INSTAGRAM_APP_SECRET=<set-as-cloudflare-secret-or-use-meta-app-secret>

# -----------------------------------------------------------------------------
# Background services / feature configuration
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
SCHEDULE_PUBLISH_INTERVAL_MS=15000
PERFORMANCE_INGEST_INTERVAL_MS=60000

COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFY_SFW_URL=
COMFY_NSFW_URL=

BLUEPRINT_READ_MODEL=legacy
BLUEPRINT_MIRROR_LEGACY=0

# CI/OpenNext compilation only. Do not configure this on the production Worker.
SKIP_ENV_VALIDATION=0
