{
  "name": "nexus-app",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:worker": "tsx server/worker/index.ts",
    "worker:health": "node tools/worker-health-check.mjs",
    "verify:domain": "node tools/verify-vercel-domain.mjs",
    "openclaw": "powershell -ExecutionPolicy Bypass -File .\\tools\\openclaw.ps1",
    "openclaw:gateway": "powershell -ExecutionPolicy Bypass -File .\\tools\\openclaw.ps1 gateway run",
    "openclaw:test-telegram": "powershell -ExecutionPolicy Bypass -File .\\tools\\openclaw.ps1 message send --channel telegram --target 8514952353 --message \"OpenClaw test from nexus-app\"",
    "supabase:check": "node tools/supabase-config-check.mjs",
    "supabase:check:ping": "node tools/supabase-config-check.mjs --ping",
    "supabase:configure": "powershell -ExecutionPolicy Bypass -File .\\tools\\supabase-configure.ps1",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "verify:deploy": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:baseline": "cmd /c \"mkdir tools\\baseline 2>nul & node_modules\\.bin\\tsc.cmd -p tsconfig.json --noEmit > tools\\baseline\\typecheck.txt 2>&1 & exit /b 0\"",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:baseline": "cmd /c \"mkdir tools\\baseline 2>nul & node_modules\\.bin\\eslint.cmd . --ext .js,.jsx,.ts,.tsx > tools\\baseline\\lint.txt 2>&1 & exit /b 0\"",
    "typecheck:v2": "tsc -p tsconfig.v2.json --noEmit",
    "lint:v2": "eslint \"server/worker/**/*.ts\" \"src/app/api/org/route.ts\" \"src/app/api/workspaces/route.ts\" \"src/app/api/creators/route.ts\" \"src/app/api/content/route.ts\" \"src/app/api/content/generate/route.ts\" \"src/app/api/schedules/route.ts\" \"src/app/api/analytics/route.ts\" \"src/app/api/portfolio/route.ts\" \"src/app/api/worker/health/route.ts\" \"src/app/api/studio/generate/route.ts\" \"src/app/api/generations/route.ts\" \"src/app/(dashboard)/portfolio/**/*.tsx\" \"src/app/(dashboard)/dashboard/**/*.tsx\" \"src/app/(dashboard)/creators/**/*.tsx\" \"src/app/(dashboard)/production/**/*.tsx\" \"src/app/(dashboard)/calendar/**/*.tsx\" \"src/app/(dashboard)/intelligence/**/*.tsx\" \"src/app/(dashboard)/settings/**/*.tsx\" \"src/components/layout/AppShell.tsx\" \"src/components/layout/Sidebar.tsx\" \"src/components/layout/TopBar.tsx\" \"src/context/WorkspaceContext.tsx\" \"src/lib/core/api.ts\" \"src/lib/core/featureFlags.ts\" \"src/lib/server/v2Access.ts\" \"src/lib/server/activityLog.ts\" \"src/lib/server/comfyui.ts\" \"src/lib/blueprint/createJob.ts\" \"src/lib/blueprint/compat/mirrorToLegacy.ts\" \"src/proxy.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1006.0",
    "@aws-sdk/s3-request-presigner": "^3.1006.0",
    "@opennextjs/cloudflare": "^1.17.1",
    "@radix-ui/react-accordion": "latest",
    "@radix-ui/react-avatar": "latest",
    "@radix-ui/react-checkbox": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-progress": "latest",
    "@radix-ui/react-scroll-area": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-switch": "latest",
    "@radix-ui/react-toast": "latest",
    "@radix-ui/react-tooltip": "latest",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.9.0",
    "@supabase/supabase-js": "2.95.3",
    "bullmq": "^5.70.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "^16.6.1",
    "ioredis": "^5.10.0",
    "lucide-react": "0.563.0",
    "moment": "2.30.1",
    "next": "16.1.6",
    "next-auth": "4.24.13",
    "next-themes": "^0.4.6",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-big-calendar": "1.19.4",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.2.4",
    "shadcn": "^3.8.5",
    "stripe": "^20.4.1",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "^4.2.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.6",
    "supabase": "^2.78.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.72.0",
    "ws": "^8.19.0"
  }
}
