{
  "name": "nexus-app",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:worker": "tsx server/worker/index.ts",
    "worker:health": "node tools/worker-health-check.mjs",
    "openclaw": "powershell -ExecutionPolicy Bypass -File .\\tools\\openclaw.ps1",
    "openclaw:gateway": "powershell -ExecutionPolicy Bypass -File .\\tools\\openclaw.ps1 gateway run",
    "openclaw:test-telegram": "powershell -ExecutionPolicy Bypass -File .\\tools\\openclaw.ps1 message send --channel telegram --target 8514952353 --message \"OpenClaw test from nexus-app\"",
    "supabase:check": "node tools/supabase-config-check.mjs",
    "supabase:check:ping": "node tools/supabase-config-check.mjs --ping",
    "supabase:configure": "powershell -ExecutionPolicy Bypass -File .\\tools\\supabase-configure.ps1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:baseline": "cmd /c \"mkdir tools\\baseline 2>nul & node_modules\\.bin\\tsc.cmd -p tsconfig.json --noEmit > tools\\baseline\\typecheck.txt 2>&1 & exit /b 0\"",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:baseline": "cmd /c \"mkdir tools\\baseline 2>nul & node_modules\\.bin\\eslint.cmd . --ext .js,.jsx,.ts,.tsx > tools\\baseline\\lint.txt 2>&1 & exit /b 0\"",
    "typecheck:v2": "tsc -p tsconfig.v2.json --noEmit",
    "lint:v2": "eslint --max-warnings=0 \"server/worker/**/*.ts\" \"src/app/api/org/route.ts\" \"src/app/api/workspaces/route.ts\" \"src/app/api/creators/route.ts\" \"src/app/api/content/route.ts\" \"src/app/api/content/generate/route.ts\" \"src/app/api/schedules/route.ts\" \"src/app/api/analytics/route.ts\" \"src/app/api/portfolio/route.ts\" \"src/app/api/worker/health/route.ts\" \"src/app/api/studio/generate/route.ts\" \"src/app/api/generations/route.ts\" \"src/app/portfolio/**/*.tsx\" \"src/app/dashboard/**/*.tsx\" \"src/app/creators/page.tsx\" \"src/app/creators/layout.tsx\" \"src/app/production/page.tsx\" \"src/app/production/layout.tsx\" \"src/app/calendar/page.tsx\" \"src/app/calendar/layout.tsx\" \"src/app/intelligence/page.tsx\" \"src/app/intelligence/layout.tsx\" \"src/app/main-layout.tsx\" \"src/app/settings/**/*.tsx\" \"src/components/Sidebar.tsx\" \"src/components/TopBar.tsx\" \"src/components/GoogleSignInButton.tsx\" \"src/context/WorkspaceContext.tsx\" \"src/lib/api.ts\" \"src/lib/featureFlags.ts\" \"src/lib/server/v2Access.ts\" \"src/lib/server/activityLog.ts\" \"src/lib/server/comfyui.ts\" \"src/lib/blueprint/createJob.ts\" \"src/lib/blueprint/compat/mirrorToLegacy.ts\" \"src/middleware.ts\""
  },
  "dependencies": {
