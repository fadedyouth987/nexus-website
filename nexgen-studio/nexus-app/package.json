    "@supabase/supabase-js": "2.95.3",
    "bullmq": "^5.58.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ioredis": "^5.8.1",
    "lucide-react": "0.563.0",
    "moment": "2.30.1",
    "next": "16.1.6",
    "next-auth": "4.24.13",
    "next-themes": "^0.4.6",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-big-calendar": "1.19.4",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.2.4",
