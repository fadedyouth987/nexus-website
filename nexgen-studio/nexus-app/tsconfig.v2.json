{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "src/types/**/*.d.ts",
    "server/worker/**/*.ts",
    "src/app/api/org/route.ts",
    "src/app/api/workspaces/route.ts",
    "src/app/api/creators/route.ts",
    "src/app/api/content/route.ts",
    "src/app/api/schedules/route.ts",
    "src/app/api/analytics/route.ts",
    "src/app/api/portfolio/route.ts",
    "src/app/api/worker/health/route.ts",
    "src/app/api/studio/generate/route.ts",
    "src/app/api/generations/route.ts",
    "src/app/(dashboard)/portfolio/**/*.ts",
    "src/app/(dashboard)/portfolio/**/*.tsx",
    "src/app/(dashboard)/dashboard/**/*.ts",
    "src/app/(dashboard)/dashboard/**/*.tsx",
    "src/app/(dashboard)/creators/**/*.ts",
    "src/app/(dashboard)/creators/**/*.tsx",
    "src/app/(dashboard)/production/**/*.ts",
    "src/app/(dashboard)/production/**/*.tsx",
    "src/app/(dashboard)/calendar/**/*.ts",
    "src/app/(dashboard)/calendar/**/*.tsx",
    "src/app/(dashboard)/intelligence/**/*.ts",
    "src/app/(dashboard)/intelligence/**/*.tsx",
    "src/app/(dashboard)/settings/**/*.ts",
    "src/app/(dashboard)/settings/**/*.tsx",
    "src/components/layout/AppShell.tsx",
    "src/components/layout/Sidebar.tsx",
    "src/components/layout/TopBar.tsx",
    "src/context/WorkspaceContext.tsx",
    "src/lib/core/api.ts",
    "src/lib/core/featureFlags.ts",
    "src/lib/server/v2Access.ts",
    "src/lib/server/activityLog.ts",
    "src/lib/server/comfyui.ts",
    "src/lib/blueprint/createJob.ts",
    "src/lib/blueprint/compat/mirrorToLegacy.ts",
    "src/proxy.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
