{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jobryn",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jobryn"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://jobryn.org",
    "NEXT_PUBLIC_SITE_URL": "https://jobryn.org",
    "NEXTAUTH_URL": "https://jobryn.org",
    "NEXT_PUBLIC_SUPABASE_URL": "https://pmqtkcenovlwshurglkp.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_H7ggm7ASPc-HgDQdMIBWeQ__9GCzVus",
    "SUPABASE_URL": "https://pmqtkcenovlwshurglkp.supabase.co"
  },
  "secrets": {
    "required": [
      "NEXTAUTH_SECRET",
      "SUPABASE_SERVICE_ROLE_KEY"
    ]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "jobryn.org",
      "custom_domain": true
    },
    {
      "pattern": "www.jobryn.org",
      "custom_domain": true
    }
  ]
}
